import torch
from transformers import AutoProcessor, AutoModelForZeroShotObjectDetection, TrainingArguments, Trainer

# 1. Initialize Processor and Model
model_id = "IDEA-Research/grounding-dino-tiny" # Or grounding-dino-base
processor = AutoProcessor.from_pretrained(model_id)
model = AutoModelForZeroShotObjectDetection.from_pretrained(model_id)

# 2. Freeze the Backbones (Partial Fine-Tuning)
# Freezing the text and vision encoders preserves broad language/vision alignment
for name, param in model.named_parameters():
    if "text_backbone" in name or "backbone" in name:
        param.requires_grad = False

# 3. Create a Data Collator for Grounding Tensors
def collate_fn(batch):
    images = [item["image"] for item in batch]
    text_queries = [item["caption"] for item in batch]
    
    # Process images and text tokens simultaneously
    inputs = processor(images=images, text=text_queries, return_tensors="pt", padding=True)
    
    # Pack ground truth bounding boxes and class labels
    labels = []
    for item in batch:
        labels.append({
            "boxes": torch.tensor(item["boxes"], dtype=torch.float32),
            "class_labels": torch.tensor(item["class_labels"], dtype=torch.long)
        })
    inputs["labels"] = labels
    return inputs

# 4. Configure Training Arguments
training_args = TrainingArguments(
    output_dir="./grounding_dino_finetuned",
    learning_rate=2e-5,          # Keep learning rate low to avoid gradient spikes
    per_device_train_batch_size=4,
    num_train_epochs=15,         # Usually converges between 10-20 epochs on partial datasets
    weight_decay=0.01,
    logging_steps=10,
    evaluation_strategy="epoch",
    save_strategy="epoch",
    fp16=True,                   # Highly recommended to save VRAM and scale speed
    remove_unused_columns=False
)

# 5. Initialize Trainer
trainer = Trainer(
    model=model,
    args=training_args,
    train_dataset=your_tokenized_train_dataset, # Map your custom COCO dataset here
    eval_dataset=your_tokenized_val_dataset,
    data_collator=collate_fn,
)

# 6. Execute Training Loop
trainer.train()

Step 4: Validate and Deploy Your Checkpoint
Once your training metrics converge (monitor via TensorBoard or Wandb), save your weights:
# Save weights and the updated config mapping
model.save_pretrained("./best_custom_dino_model")
processor.save_pretrained("./best_custom_dino_model")

from transformers import pipeline

detector = pipeline(
    model="./best_custom_dino_model", 
    task="zero-shot-object-detection", 
    device=0 # Move to GPU
)

results = detector(
    "path_to_test_image.jpg",
    candidate_labels=["your custom label"],
    threshold=0.35
)
print(results)





